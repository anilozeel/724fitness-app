# ===== 724 Fitness Club - Backend Ortam Değişkenleri =====
# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun.
# Plesk'te bu değerleri "Node.js" uygulama ayarlarından da girebilirsiniz.

# Sunucu portu (Plesk genelde kendi portunu atar, lokalde 4000)
PORT=4000

# Ortam: development (lokal) | production (Plesk/canlı)
NODE_ENV=development

# ----- Veritabanı -----
# DB_DIALECT: lokalde "sqlite", Plesk'te "mysql"
DB_DIALECT=sqlite

# SQLite için (lokal geliştirme) - başka ayar gerekmez
DB_STORAGE=./data/dev.sqlite

# MySQL için (Plesk canlı) - DB_DIALECT=mysql yapınca bunları doldurun
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fitness_db
DB_USER=fitness_user
DB_PASSWORD=degistir_bunu

# ----- Güvenlik -----
# JWT token imzalama anahtarı - CANLIDA MUTLAKA uzun ve rastgele bir değer yapın!
JWT_SECRET=bu-degeri-canlida-uzun-rastgele-bir-sey-ile-degistirin
JWT_EXPIRES_IN=7d

# Frontend'in adresi (CORS için). Canlıda: https://724fitnessclub.com
CLIENT_URL=http://localhost:5173
